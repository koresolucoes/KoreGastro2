# ChefOS Environment Variables Template
# Copy this file to .env and fill in your actual credentials.
# NEVER commit .env to version control!

# Supabase (Public Client & Private Backend)
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Google Gemini AI (Server-Side Only)
GEMINI_API_KEY=your_gemini_api_key_here

# Cielo E-Commerce Integration (Server-Side Only)
CIELO_MERCHANT_ID=your_cielo_merchant_id_here
CIELO_MERCHANT_KEY=your_cielo_merchant_key_here
CIELO_ENVIRONMENT=sandbox

# Cielo LIO Terminal Proxy Integration (Server-Side Only)
CIELO_LIO_CLIENT_ID=your_cielo_lio_client_id_here
CIELO_LIO_ACCESS_TOKEN=your_cielo_lio_access_token_here
CIELO_LIO_SANDBOX_CLIENT_ID=your_cielo_lio_sandbox_client_id_here
CIELO_LIO_SANDBOX_ACCESS_TOKEN=your_cielo_lio_sandbox_access_token_here

# Mercado Pago Integration
MERCADO_PAGO_PUBLIC_KEY=your_mercadopago_public_key_here
MERCADOPAGO_ACCESS_TOKEN=your_mercadopago_access_token_here

# iFood Integration (Server-Side Only)
IFOOD_CLIENT_ID=your_ifood_client_id_here
IFOOD_CLIENT_SECRET=your_ifood_client_secret_here
IFOOD_API_URL=https://merchant-api.ifood.com.br

# WhatsApp Business API / Meta (Server-Side Only)
WHATSAPP_TOKEN=your_whatsapp_bearer_token_here
WHATSAPP_PHONE_ID=your_whatsapp_phone_number_id_here
FACEBOOK_APP_ID=your_facebook_app_id_here
FACEBOOK_APP_SECRET=your_facebook_app_secret_here

# FocusNFe Integration (Server-Side Only)
FOCUS_NFE_TOKEN=your_focusnfe_token_here

# Upstash Redis Cache / Rate Limiting (Server-Side Only)
UPSTASH_REDIS_REST_URL=your_upstash_redis_rest_url_here
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here
